NODE_ENV=development
DATABASE_URL=postgresql://habit_app:habit_app@localhost:5432/habit_app_dev
# Auth.js JWT署名鍵(最低32文字のランダム値、本番は環境ごとに個別発行しrotateする)
AUTH_SECRET=development-only-secret-change-me-32chars
AUTH_EMAIL_SENDER=smtp
# ローカルのメールは Mailpit(pnpm mail:up)に届く。確認は http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@habit-app.local
APP_BASE_URL=http://localhost:3000
# AI job(T-303)。inline は同一プロセスで処理するローカル/E2E専用(本番はsqs。adapterはT-501で実装)
AI_QUEUE_DRIVER=inline
AI_PROVIDER=fake
# AI提案の公開flag。falseの間はproviderを呼ばず定型fallbackで完結する
AI_PUBLICATION_ENABLED=false
